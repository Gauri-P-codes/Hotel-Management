    void remove(ArrayList<Guest> move) {
        if (!move.isEmpty()) {
            for (Guest p : move) {
                present.remove(p);
            }
        }
    }

    @Override
    public void update() {
        // REMOVED: check();  -> no longer needed
        System.out.print("Enter your name :");
        String check_name = sc.next();
        System.out.print("Enter Authentication ID Provided During booking(Aadhar card/Passport/Driving License / PAN Card) :");
        String check_id = sc.next();
        System.out.print("Please enter the number of rooms you wish to update.");
        int num = sc.nextInt();
        boolean check = false, avail = false;
        for (int j = 0; j < num; j++) {
            System.out.println("Kindly specify the type of room you wish to update.");
            String room_type_updation = sc.next();
            System.out.println("Enter room number:");
            int room_num = sc.nextInt();
            for (Guest g : present) {
                if (g.typeRoom.equals(room_type_updation) && g.room != -1) {
                    avail = false;
                } else {
                    avail = true;
                }
            }
            if (avail) {
                for (Guest g : present) {
                    if (g.name.equals(check_name) && g.id.equals(check_id) && g.room == room_num) {
                        LocalDate checkIn = LocalDate.now();
                        LocalDate checkOut = checkIn.plusDays(g.day);
                        int newRoom = availabilityService.findAvailableRoom(room_type_updation, checkIn, checkOut);

                        if (newRoom > -1) {
                            // CHANGED: now also updates MySQL, not just the in-memory Guest object
                            boolean updated = dao.updateRoom(g.name, g.phno, g.room, newRoom, room_type_updation);

                            if (updated) {
                                int oldRoom = g.room;
                                g.typeRoom = room_type_updation;
                                g.per = Price.valueOf(room_type_updation);
                                g.room = newRoom;

                                // Free the old room in MySQL since this guest no longer occupies it
                                dao.freeRoom(oldRoom);

                                check = true;
                                System.out.println("Successfully Updated!");
                            } else {
                                System.out.println("Database update failed. Room not changed.");
                            }
                        } else {
                            System.out.println("No room available in the new category.");
                            avail = false;
                        }
                    }
                }
                if (!check) {
                    System.out.println("Invalid Details");
                }
            } else {
                System.out.println("Sorry, Room not Available. ");
            }
        }
    }

    @Override
    public void search() {
        // unchanged — search() only reads `present`, no array/room() dependency
        boolean flag = false;
        System.out.println("Menu : ");
        System.out.println("1) Name");
        System.out.println("2) Sources of Booking");
        System.out.println("3) Room No.");
        System.out.println("4) Date");
        System.out.println("5) Phone Number");
        System.out.println("6) Type of Room");
        System.out.print("Enter your choice : ");
        int ch = sc.nextInt();
        switch (ch) {
            case 1:
                System.out.print("Enter Name :");
                String name = sc.next();
                for (Guest i : present) {
                    if (i.name.equalsIgnoreCase(name)) {
                        flag = true;
                        i.display();
                    }
                }
                break;
            case 2:
                System.out.print("Enter Platform for  booking :");
                Modeofbooking mode;
                try {
                    String sourc = sc.next();
                    mode = Modeofbooking.valueOf(sourc.toUpperCase());
                    for (Guest i : present) {
                        if (i.mode.equals(mode)) {
                            flag = true;
                            i.display();
                        }
                    }
                } catch (Exception e) {
                    System.out.println("Invalid Input");
                }
                break;
            case 3:
                System.out.print("Enter Room No. to search :");
                int rm = sc.nextInt();
                for (Guest i : present) {
                    if (i.room == rm) {
                        flag = true;
                        i.display();
                    }
                }
                break;
            case 4:
                System.out.println("Enter the Check-in date :");
                String date1 = HotelInterfaces.date(2);
                try {
                    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
                    LocalDate date = LocalDate.parse(date1, formatter);
                    for (Guest i : present) {
                        if (date.isEqual(i.cindate)) {
                            flag = true;
                            i.display();
                        }
                    }
                } catch (Exception e) {
                    System.out.println("Invalid Input");
                }
                break;
            case 5:
                System.out.print("Enter Phone Number :");
                long phno = sc.nextLong();
                for (Guest i : present) {
                    if (i.phno == phno) {
                        flag = true;
                        i.display();
                    }
                }
                break;
            case 6:
                System.out.print("Enter Type :");
                Price per;
                try {
                    String type = sc.next();
                    per = Price.valueOf(type);
                    for (Guest i : present) {
                        if (i.per.equals(per)) {
                            flag = true;
                            i.display();
                        }
                    }
                } catch (Exception e) {
                    System.out.println("Invalid Input");
                }
                break;
            default:
                System.out.println("Invalid Input");
        }
        if (!flag) {
            System.out.println("Guest not found");
        }
    }

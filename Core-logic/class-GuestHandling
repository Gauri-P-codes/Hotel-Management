    @Override
    public void accept() {
        System.out.print("Is There a Pre-booking ?(1-yes,0-no) : ");
        int ch = sc.nextInt();
        if (ch == 0) {
            System.out.print("Enter the phone number to Register : ");
            long phno = sc.nextLong();
            System.out.print("Enter the Guest Name : ");
            String name = sc.next();
            System.out.print("Enter the Authentication Id : (Aadhar card/Passport/ Driving License /PAN card ) :");
            String id = sc.next();
            System.out.print("Enter the Number of Rooms Required :");
            int x = sc.nextInt();
            System.out.print("Enter the Length of Stay (in days) :");
            int day = sc.nextInt();
            while (day < 0) {
                System.out.print("Enter the Length of Stay (in days) :");
                day = sc.nextInt();
            }
            System.out.print("Enter the Platform for booking (ONLINE/OFFLINE) :");
            String src;
            Modeofbooking mode;
            try {
                src = sc.next().toUpperCase();
                mode = Modeofbooking.valueOf(src);
            } catch (IllegalArgumentException e) {
                System.out.println("Booking mode is changed to OFFLINE");
                mode = Modeofbooking.OFFLINE;
            } catch (Exception e) {
                System.out.println("Booking mode is changed to OFFLINE");
                mode = Modeofbooking.OFFLINE;
            }

            // REMOVED: check();  -> was only needed to refresh the boolean arrays

            for (int i = 1; i <= x; i++) {
                System.out.println("For room " + i + " : ");
                System.out.println("Types of Rooms Available: guest_room/executive_suite/soho_suite/presidential_suite");
                System.out.print("Enter  Desired Room Type :");
                String typeRoom = sc.next();
                Price per;
                try {
                    per = Price.valueOf(typeRoom);
                } catch (Exception e) {
                    System.out.println("Invalid room Type!\t\tChanging the room to single.");
                    typeRoom = "guest_room";
                    per = Price.guest_room;
                }

                // CHANGED: was room(per) using boolean arrays
                // Walk-in = staying from today for `day` days
                LocalDate checkIn = LocalDate.now();
                LocalDate checkOut = checkIn.plusDays(day);
                int room = availabilityService.findAvailableRoom(typeRoom, checkIn, checkOut);

                if (room > -1) {
                    // Dual-write: MySQL (so future availability checks see this booking) + present (console flow)
                    boolean saved = dao.insertBooking(name, phno, room, typeRoom, checkIn, day, mode.toString());
                    if (saved) {
                        present.add(new Guest(name, id, typeRoom, per, day, phno, mode, LocalDate.now(), LocalTime.now(), room));
                        System.out.println("Details of Guest Registered!");
                    } else {
                        System.out.println("Something went wrong saving to database.");
                    }
                } else {
                    System.out.println("Room NOT available in the selected category. Please choose another room type.");
                }
            }
        } else {
            boolean flag = false;
            System.out.print("Enter the Guest Name : ");
            String name = sc.next();
            System.out.print("Enter the Phone Number to Register :");
            long phno = sc.nextLong();
            for (Guest i : future) {
                LocalDate n = i.cindate.plusDays(i.day);
                if (i.name.equalsIgnoreCase(name) && i.phno == phno) {
                    LocalDate nc = LocalDate.now();
                    if(nc.equals(i.cindate) || nc.isAfter(i.cindate) && nc.isBefore(n)){
                        System.out.print("Enter the Authentication ID : (Aadhar card/Passport/Driving License/ PAN Card ) :");
                        String id=sc.next();
                        present.add(new Guest(i,id));
                        future.remove(i);           // NEW: remove from future once checked in
                        dao.deleteBooking(i.name, i.phno, i.room); // NEW: keep MySQL in sync too
                        flag=true;
                        System.out.println("Details Registered ! ");
                        System.out.println("Have a Nice Stay ! ") ;
                        break;                       // NEW: avoid ConcurrentModificationException from modifying `future` mid-loop
                    }
                }
            }
            if (!flag) {
                System.out.println(" Sorry ! No Advance Booking Found ");
            }
        }
    }

    protected LocalDate date() {
        LocalDate date;
        System.out.println("Enter The Dates Of Stay  : ");
        String d = HotelInterfaces.date(1);
        try {
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
            date = LocalDate.parse(d, formatter);
        } catch (Exception e) {
            date = LocalDate.now();
            System.out.println("Invalid Input.Please Retry ");
        }
        return date;
    }

